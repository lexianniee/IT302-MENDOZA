# Runtime data — keep the directories, ignore their contents
mysql/data/*
!mysql/data/.gitkeep
redis/data/*
!redis/data/.gitkeep

# Generated by the devilbox entrypoint into the mounted conf.d at container start
php/conf.d/devilbox-runtime-*.ini
php/conf.d/zzz-entrypoint-*.ini

# Local TLS material
nginx/ssl/*
!nginx/ssl/.gitkeep

# OS / editor noise
.DS_Store
Thumbs.db
